//-
//- app.component.pug — carrasco-leo
//- ~/projects/app-client/src/app
//-

-
	const links = [
		// { label: '<label>', routerLink: '<route>' },
		{ label: 'Main', routerLink: 'main' },
	];

cl-page-layout
	cl-page-layout-topbar
		@if (appReady()) {
			a(cl-page-layout-topbar-link, routerLink=".") Carrasco Léo

			@if (desktopQuery.matches) {
				each link in links
					a(
						cl-page-layout-topbar-link,
						routerLink=link.routerLink,
						routerLinkActive="active",
						)
						| #{link.label}
			}

			div.flex-auto
		}

	cl-page-layout-sidenav
		@if (!desktopQuery.matches) {
			cl-page-layout-sidenav-header
				each link in links
					a(
						cl-page-layout-sidenav-link,
						routerLink=link.routerLink,
						routerLinkActive="active",
						)
						| #{link.label}
		}

		cl-page-layout-sidenav-footer
			button(cl-page-layout-sidenav-link)
				mat-icon settings
				span Settings

	cl-page-layout-body
		router-outlet

cl-page-layout-category(cat-id="menu-1", label="Menu #1", actived)
ng-template(cl-page-layout-template, category="menu-1")
	a(
		cl-page-layout-sidenav-link,
		routerLink="menu-1/link-1",
		routerLinkActive="active",
		)
		mat-icon home
		span Link #1
	a(
		cl-page-layout-sidenav-link,
		routerLink="menu-1/link-2",
		routerLinkActive="active",
		)
		mat-icon settings
		span Link #2
	a(
		cl-page-layout-sidenav-link,
		routerLink="menu-1/link-3",
		routerLinkActive="active",
		)
		mat-icon add
		span Link #3

cl-page-layout-category(cat-id="menu-2", label="Menu #2")
ng-template(cl-page-layout-template, category="menu-2")
	a(
		cl-page-layout-sidenav-link,
		routerLink="menu-2/link-1",
		routerLinkActive="active",
		)
		mat-icon home
		span Link #1
	a(
		cl-page-layout-sidenav-link,
		routerLink="menu-2/link-2",
		routerLinkActive="active",
		)
		mat-icon settings
		span Link #2
	a(
		cl-page-layout-sidenav-link,
		routerLink="menu-2/link-3",
		routerLinkActive="active",
		)
		mat-icon add
		span Link #3
