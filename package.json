{
  "private": true,
  "name": "carrasco-leo",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -n pug,ng -c yellow,blue \"npm run pug:watch\" \"ng serve\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pug:build": "pug-compiler --control-flow-plugins",
    "pug:watch": "pug-compiler --watch --control-flow-plugins",
    "prebuild": "npm run pug:build",
    "prestart": "npm run pug:build"
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@carrasco-leo/ng": "file:dist/ng",
    "primeflex": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "@carrasco-leo/angular-pug-compiler": "^0.2.0",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^10.0.5",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.4.0",
    "jsdom": "^30.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
